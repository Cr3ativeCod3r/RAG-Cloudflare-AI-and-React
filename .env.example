# ==========================================
# Konfiguracja Frontendu (Astro / Vite)
# ==========================================

# URL do wdrożonego API Workera na Cloudflare.
# Astro wymaga prefiksu PUBLIC_ dla zmiennych dostępnych w przeglądarce.
PUBLIC_WORKER_URL="https://astra-chat-api.banaszekk123.workers.dev"


# ==========================================
# Konfiguracja API Workera (Cloudflare)
# (Te zmienne ustawiasz w Cloudflare Dashboard -> Twoj Worker -> Settings -> Variables
#  albo dopisujesz do sekcji [vars] w pliku worker/wrangler.json)
# ==========================================

# Ile fragmentów z bazy wektorowej ma pobierać RAG przy każdym zapytaniu
# (Wyższa liczba = więcej kontekstu dla AI, ale dłuższy czas oczekiwania)
RAG_TOP_K="3"

# Model językowy do generowania odpowiedzi na podstawie kontekstu
CHAT_MODEL="@cf/meta/llama-3.1-8b-instruct-fp8"

# Maksymalna liczba tokenów w odpowiedzi (długość odpowiedzi)
CHAT_MAX_TOKENS="1024"

# Temperatura modelu (im mniejsza, tym bardziej precyzyjne odpowiedzi, 0.3-0.5 to optymalnie dla RAG)
CHAT_TEMPERATURE="0.3"

# Model do generowania embeddingów (musi być taki sam podczas zasilania bazy i zadawania pytań)
EMBEDDING_MODEL="@cf/baai/bge-base-en-v1.5"

# Paczkowanie danych podczas /seed (ile wektorów wrzucać naraz do Vectorize, żeby nie przekroczyć limitów API)
SEED_BATCH_SIZE="50"

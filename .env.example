# ==========================================
# Frontend Configuration (Astro / Vite)
# ==========================================

# URL to the deployed Cloudflare Worker API.
# Astro requires the PUBLIC_ prefix for variables available in the browser.
PUBLIC_WORKER_URL="https://astra-chat-api.banaszekk123.workers.dev"


# ==========================================
# Worker API Configuration (Cloudflare)
# (Set these in Cloudflare Dashboard -> Your Worker -> Settings -> Variables
#  or add them to the [vars] section in worker/wrangler.json)
# ==========================================

# How many chunks to retrieve from the vector database per query
# (Higher number = more context for AI, but slightly longer response time)
RAG_TOP_K="3"

# The language model used to generate answers based on context
CHAT_MODEL="@cf/meta/llama-3.1-8b-instruct-fp8"

# Maximum number of tokens in the response (response length limit)
CHAT_MAX_TOKENS="1024"

# Model temperature (lower = more deterministic and precise answers, 0.3-0.5 is optimal for RAG)
CHAT_TEMPERATURE="0.3"

# The model used for generating embeddings (must be the same for /seed and /chat endpoints)
EMBEDDING_MODEL="@cf/baai/bge-base-en-v1.5"

# Batch size for /seed data ingestion (how many vectors to upsert at once to avoid API limits)
SEED_BATCH_SIZE="50"

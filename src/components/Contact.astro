---
/**
 * Contact — sekcja kontaktowa z mapą, danymi i formularzem CTA.
 */
---

<section id="kontakt" class="py-24 bg-brand-50/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-brand-500 text-sm font-semibold tracking-[0.2em] uppercase mb-3">
        Kontakt
      </p>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
        Odwiedź nas
      </h2>
      <p class="text-gray-500 max-w-2xl mx-auto text-lg">
        Zarezerwuj wizytę telefonicznie lub odwiedź nas osobiście.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Info -->
      <div class="space-y-8">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-brand-100 rounded-xl flex items-center justify-center flex-shrink-0">
            <span class="text-xl">📍</span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Adres</h3>
            <p class="text-gray-500 text-sm">ul. Kwiatowa 15, 00-001 Warszawa</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-brand-100 rounded-xl flex items-center justify-center flex-shrink-0">
            <span class="text-xl">📞</span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Telefon</h3>
            <p class="text-gray-500 text-sm">+48 123 456 789</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-brand-100 rounded-xl flex items-center justify-center flex-shrink-0">
            <span class="text-xl">✉️</span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Email</h3>
            <p class="text-gray-500 text-sm">kontakt@astrabeauty.pl</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-brand-100 rounded-xl flex items-center justify-center flex-shrink-0">
            <span class="text-xl">🕐</span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Godziny otwarcia</h3>
            <div class="text-gray-500 text-sm space-y-1">
              <p>Poniedziałek — Piątek: 9:00 — 20:00</p>
              <p>Sobota: 9:00 — 16:00</p>
              <p>Niedziela: nieczynne</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Card -->
      <div class="bg-white p-8 sm:p-10 rounded-2xl shadow-sm border border-gray-100">
        <h3 class="font-display text-2xl font-bold text-gray-900 mb-3">
          Zarezerwuj wizytę
        </h3>
        <p class="text-gray-500 text-sm mb-8">
          Zadzwoń lub napisz — dobierzemy idealny zabieg i termin dla Ciebie.
        </p>

        <div class="space-y-4">
          <a
            href="tel:+48123456789"
            class="flex items-center justify-center gap-2 w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-4 rounded-xl transition-colors"
          >
            📞 Zadzwoń teraz
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full border border-gray-200 hover:border-brand-300 text-gray-700 hover:text-brand-600 font-semibold py-4 rounded-xl transition-colors"
          >
            📸 Napisz na Instagramie
          </a>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-100">
          <p class="text-xs text-gray-400 text-center">
            Odpowiadamy w ciągu 30 minut w godzinach otwarcia
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

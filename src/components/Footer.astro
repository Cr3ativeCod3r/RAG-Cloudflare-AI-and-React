---
/**
 * Footer — stopka z logo, linkami i informacjami prawnymi.
 */
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-xl">✦</span>
          <span class="font-display text-lg font-bold tracking-wide">
            ASTRA BEAUTY
          </span>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed max-w-sm">
          Profesjonalny salon kosmetyczny w sercu Warszawy.
          Odkryj piękno, które w Tobie drzemie — zarezerwuj wizytę już dziś.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-300 mb-4">
          Nawigacja
        </h4>
        <ul class="space-y-2">
          <li><a href="#uslugi" class="text-gray-400 hover:text-white text-sm transition-colors">Usługi</a></li>
          <li><a href="#o-nas" class="text-gray-400 hover:text-white text-sm transition-colors">O nas</a></li>
          <li><a href="#galeria" class="text-gray-400 hover:text-white text-sm transition-colors">Galeria</a></li>
          <li><a href="#cennik" class="text-gray-400 hover:text-white text-sm transition-colors">Cennik</a></li>
          <li><a href="#kontakt" class="text-gray-400 hover:text-white text-sm transition-colors">Kontakt</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-300 mb-4">
          Kontakt
        </h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          <li>ul. Kwiatowa 15</li>
          <li>00-001 Warszawa</li>
          <li class="pt-2">
            <a href="tel:+48123456789" class="hover:text-white transition-colors">
              +48 123 456 789
            </a>
          </li>
          <li>
            <a href="mailto:kontakt@astrabeauty.pl" class="hover:text-white transition-colors">
              kontakt@astrabeauty.pl
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-gray-500 text-xs">
        © 2026 Astra Beauty. Wszelkie prawa zastrzeżone.
      </p>
      <div class="flex gap-4 text-gray-500 text-xs">
        <a href="#" class="hover:text-white transition-colors">Polityka prywatności</a>
        <a href="#" class="hover:text-white transition-colors">Regulamin</a>
      </div>
    </div>
  </div>
</footer>

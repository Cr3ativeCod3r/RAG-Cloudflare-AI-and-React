---
/**
 * Hero — pełnoekranowa sekcja powitalna z CTA.
 * Ciemny overlay na tle, żeby tekst był czytelny.
 * Gradient od brand colors zamiast zdjęcia (placeholder).
 */
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background gradient (zastąp zdjęciem w produkcji) -->
  <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-brand-900 to-gray-900"></div>
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.03%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')] opacity-50"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
    <p class="text-brand-300 text-sm font-semibold tracking-[0.3em] uppercase mb-6">
      Salon Kosmetyczny
    </p>

    <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-tight mb-6">
      Odkryj piękno,<br />
      <span class="text-brand-400 italic">które w Tobie drzemie</span>
    </h1>

    <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
      Profesjonalne zabiegi kosmetyczne w sercu miasta.
      Relaks, odmłodzenie i naturalne piękno — wszystko w jednym miejscu.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#kontakt"
        class="bg-brand-500 hover:bg-brand-600 text-white font-semibold px-8 py-4 rounded-full text-base transition-all hover:shadow-lg hover:shadow-brand-500/25"
      >
        Zarezerwuj wizytę
      </a>
      <a
        href="#uslugi"
        class="border border-white/30 hover:border-white/60 text-white font-semibold px-8 py-4 rounded-full text-base transition-all hover:bg-white/10"
      >
        Zobacz usługi
      </a>
    </div>

    <!-- Trust indicators -->
    <div class="mt-16 flex flex-wrap items-center justify-center gap-8 text-white/50 text-sm">
      <div class="flex items-center gap-2">
        <span class="text-gold-400">★★★★★</span>
        <span>4.9 na Google</span>
      </div>
      <div class="w-px h-4 bg-white/20 hidden sm:block"></div>
      <div>500+ zadowolonych klientek</div>
      <div class="w-px h-4 bg-white/20 hidden sm:block"></div>
      <div>8 lat doświadczenia</div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

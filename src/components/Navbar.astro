---
/**
 * Navbar — responsywna nawigacja salonu.
 * Na mobile: hamburger menu. Na desktop: inline links.
 * Tło jest transparentne na hero, nabiera koloru po scroll (JS inline).
 */
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2">
        <span class="text-2xl">✦</span>
        <span class="font-display text-xl font-bold tracking-wide text-white" id="nav-logo">
          ASTRA BEAUTY
        </span>
      </a>

      <!-- Desktop links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#uslugi" class="nav-link text-sm font-medium text-white/80 hover:text-white transition-colors">Usługi</a>
        <a href="#o-nas" class="nav-link text-sm font-medium text-white/80 hover:text-white transition-colors">O nas</a>
        <a href="#galeria" class="nav-link text-sm font-medium text-white/80 hover:text-white transition-colors">Galeria</a>
        <a href="#opinie" class="nav-link text-sm font-medium text-white/80 hover:text-white transition-colors">Opinie</a>
        <a href="#cennik" class="nav-link text-sm font-medium text-white/80 hover:text-white transition-colors">Cennik</a>
        <a href="#kontakt" class="nav-link text-sm font-medium text-white/80 hover:text-white transition-colors">Kontakt</a>
        <a
          href="#kontakt"
          class="bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors"
        >
          Zarezerwuj
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="md:hidden text-white p-2"
        aria-label="Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-md border-t border-gray-100">
    <div class="px-4 py-4 space-y-3">
      <a href="#uslugi" class="mobile-link block text-sm font-medium text-gray-700 hover:text-brand-600">Usługi</a>
      <a href="#o-nas" class="mobile-link block text-sm font-medium text-gray-700 hover:text-brand-600">O nas</a>
      <a href="#galeria" class="mobile-link block text-sm font-medium text-gray-700 hover:text-brand-600">Galeria</a>
      <a href="#opinie" class="mobile-link block text-sm font-medium text-gray-700 hover:text-brand-600">Opinie</a>
      <a href="#cennik" class="mobile-link block text-sm font-medium text-gray-700 hover:text-brand-600">Cennik</a>
      <a href="#kontakt" class="mobile-link block text-sm font-medium text-gray-700 hover:text-brand-600">Kontakt</a>
      <a
        href="#kontakt"
        class="block text-center bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors"
      >
        Zarezerwuj wizytę
      </a>
    </div>
  </div>
</nav>

<script>
  // Scroll: transparent → solid background
  const navbar = document.getElementById("navbar")!;
  const logo = document.getElementById("nav-logo")!;
  const navLinks = document.querySelectorAll(".nav-link");

  function updateNavbar() {
    if (window.scrollY > 50) {
      navbar.classList.add("bg-white/95", "backdrop-blur-md", "shadow-sm");
      navbar.classList.remove("bg-transparent");
      logo.classList.remove("text-white");
      logo.classList.add("text-gray-900");
      navLinks.forEach((l) => {
        l.classList.remove("text-white/80", "hover:text-white");
        l.classList.add("text-gray-600", "hover:text-brand-600");
      });
    } else {
      navbar.classList.remove("bg-white/95", "backdrop-blur-md", "shadow-sm");
      navbar.classList.add("bg-transparent");
      logo.classList.add("text-white");
      logo.classList.remove("text-gray-900");
      navLinks.forEach((l) => {
        l.classList.add("text-white/80", "hover:text-white");
        l.classList.remove("text-gray-600", "hover:text-brand-600");
      });
    }
  }

  window.addEventListener("scroll", updateNavbar);
  updateNavbar();

  // Mobile menu toggle
  const toggle = document.getElementById("menu-toggle")!;
  const mobileMenu = document.getElementById("mobile-menu")!;
  const mobileLinks = document.querySelectorAll(".mobile-link");

  toggle.addEventListener("click", () => {
    mobileMenu.classList.toggle("hidden");
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
    });
  });
</script>
